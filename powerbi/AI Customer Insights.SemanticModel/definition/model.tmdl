model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "_Measures", "fact_orders", "fact_order_items", "fact_reviews", "review_ai_labels", "dim_customer", "dim_product", "dim_seller", "dim_date"]

ref table _Measures
ref table fact_orders
ref table fact_order_items
ref table fact_reviews
ref table review_ai_labels
ref table dim_customer
ref table dim_product
ref table dim_seller
ref table dim_date
