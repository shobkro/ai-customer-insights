# Copy this file to .env and pick ONE free provider.

# --- Option A: Ollama (recommended - 100% free, runs on your laptop, no key) ---
# 1. Install from https://ollama.com   2. Run:  ollama pull qwen2.5:7b
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Low on RAM (8 GB)? use a smaller model: OLLAMA_MODEL=qwen2.5:3b  (or llama3.2:3b)

# --- Option B: Groq free tier (fast, needs a free key from console.groq.com) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# --- Option C: Google Gemini free tier (free key from aistudio.google.com) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Model names and free-tier limits change - check the provider's site if a model is not found.
